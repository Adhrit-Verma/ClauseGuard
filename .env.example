# Pick one provider. If ANTHROPIC_API_KEY is unset, ollama is used automatically.
CLAUSEGUARD_LLM_PROVIDER=ollama
CLAUSEGUARD_MODEL=qwen2.5:7b

# Anthropic (paid)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# CLAUSEGUARD_LLM_PROVIDER=anthropic
# CLAUSEGUARD_MODEL=claude-sonnet-5

# Ollama (free, local -- requires `ollama serve` running)
# Use 127.0.0.1, not localhost -- on Windows, localhost adds ~2s to every call (IPv6 tried first).
OLLAMA_HOST=http://127.0.0.1:11434
# Seconds per model call. Raise it if the first review times out while a large model loads.
OLLAMA_TIMEOUT=600
# How long the model stays loaded after the last call ("-1" = forever, pins VRAM).
OLLAMA_KEEP_ALIVE=30m
# Context window (tokens). Fixed per run -- changing it reloads the model. Bigger = longer
# contracts fit, but more VRAM; if the model spills onto the CPU, reviews get several times slower.
OLLAMA_NUM_CTX=8192

CLAUSEGUARD_DB=clauseguard.db
# Failed reviews older than this many seconds are deleted when the next review starts (0 = keep them).
CLAUSEGUARD_FAILED_TTL=3600
